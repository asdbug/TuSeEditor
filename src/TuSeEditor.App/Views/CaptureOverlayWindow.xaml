<Window x:Class="TuSeEditor.App.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抓图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        ShowActivated="True"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Canvas x:Name="Root" Background="Black" MouseLeftButtonDown="Root_MouseDown"
            MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseUp"
            MouseRightButtonDown="Root_RightDown">
        <Image x:Name="ScreenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Rectangle x:Name="Dim" Fill="#78000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="Selection" Stroke="#FF3399FF" StrokeThickness="1.5" Fill="#223399FF"
                   Visibility="Hidden" IsHitTestVisible="False"/>
        <TextBlock x:Name="SizeLabel" Foreground="White" Background="#CC000000" Padding="4,1"
                   FontSize="12" Visibility="Hidden" IsHitTestVisible="False"/>
        <Border x:Name="Magnifier" Background="#F0202020" BorderBrush="#FF666666" BorderThickness="1"
                CornerRadius="3" Padding="4" Visibility="Hidden" IsHitTestVisible="False">
            <StackPanel>
                <Image x:Name="MagImage" Width="126" Height="126" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="MagText" Foreground="White" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="#CC1B6DC8" CornerRadius="0,0,6,0" Padding="14,8" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13"/>
        </Border>
        <Button x:Name="CancelBtn" Content="✕ 取消 (Esc)" FontSize="13" Padding="10,5"
                Background="#CCDC2626" Foreground="White" BorderBrush="White" Cursor="Hand"
                Click="CancelBtn_Click"/>
    </Canvas>
</Window>
