<Window x:Class="TuSeEditor.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助 - 图色脚本编辑器" Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F4F6">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TopicList" Margin="8,8,0,8" FontSize="13" Padding="0,4"
                 SelectionChanged="TopicList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <Border Grid.Column="1" Background="White" Margin="8,8,8,8" CornerRadius="6"
                BorderBrush="#FFE2E8F0" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="Doc" Padding="16,12"/>
        </Border>
    </Grid>
</Window>
