<Window x:Class="TuSeEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TuSeEditor.App.ViewModels"
        xmlns:conv="clr-namespace:TuSeEditor.App.Views"
        Title="图色脚本编辑器" Height="760" Width="1280"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F4F6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:PathToImageConverter x:Key="PathToImage"/>

        <!-- 属性行模板 -->
        <Style x:Key="RowBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
        </Style>
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:NumberRowVM}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextRowVM}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KeysRowVM}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="格式:单个键 a / F5 / space,组合键 ctrl+s" Foreground="#FF94A3B8" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MultiTextRowVM}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ComboRowVM}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" Padding="4,3"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CheckRowVM}">
            <StackPanel Margin="0,4">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ColorRowVM}">
            <StackPanel Margin="0,4" Visibility="{Binding IsVisible, Converter={StaticResource Bool2Vis}}">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="26" Height="26" RadiusX="3" RadiusY="3" Stroke="#FF94A3B8"
                               Fill="{Binding Value, Converter={StaticResource HexToBrush}}"/>
                    <TextBox Style="{StaticResource RowBox}" Width="86" Margin="6,0,0,0"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource RowBtn}" Content="取色" Margin="6,0,0,0" Click="OnPickColor"/>
                    <Button Style="{StaticResource RowBtn}" Content="测试" Click="OnTestColor"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TemplateRowVM}">
            <StackPanel Margin="0,4" Visibility="{Binding IsVisible, Converter={StaticResource Bool2Vis}}">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" IsReadOnly="True"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Style="{StaticResource RowBtn}" Content="🖼 抓模板图" Click="OnCaptureTemplate"/>
                    <Button Style="{StaticResource RowBtn}" Content="选择图片" Click="OnBrowseTemplate"/>
                    <Button Style="{StaticResource RowBtn}" Content="🔍 测试找图" Click="OnTestTemplate"/>
                </StackPanel>
                <Border Height="64" Margin="0,6,0,0" Background="#FFEEF2F7" CornerRadius="3" HorizontalAlignment="Left"
                        Padding="2" BorderBrush="#FFCBD5E1" BorderThickness="1">
                    <Image Source="{Binding Value, Converter={StaticResource PathToImage}}" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegionRowVM}">
            <StackPanel Margin="0,4" Visibility="{Binding IsVisible, Converter={StaticResource Bool2Vis}}">
                <TextBlock Text="{Binding Label}" Foreground="#FF475569" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Style="{StaticResource RowBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Style="{StaticResource RowBtn}" Content="⬚ 框选区域" Click="OnPickRegion"/>
                    <Button Style="{StaticResource RowBtn}" Content="全屏" Click="OnRegionFull"/>
                </StackPanel>
                <TextBlock Text="坐标为屏幕绝对像素;区域越小找图越快" Foreground="#FF94A3B8" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 步骤树节点 -->
        <Style x:Key="TreeItemText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Background="#FF1E293B" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📄 新建" Click="OnNew" Background="#FF334155" Foreground="White" BorderBrush="Transparent" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="📂 打开" Click="OnOpen" Background="#FF334155" Foreground="White" BorderBrush="Transparent" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="💾 保存" Click="OnSave" Background="#FF334155" Foreground="White" BorderBrush="Transparent" Padding="10,5" Margin="0,0,16,0"/>
                <Button Content="▶ 运行 (F9)" Click="OnRun" Background="#FF16A34A" Foreground="White" BorderBrush="Transparent" Padding="12,5" Margin="0,0,6,0" FontWeight="Bold"/>
                <Button Content="■ 停止 (F10)" Click="OnStop" Background="#FFDC2626" Foreground="White" BorderBrush="Transparent" Padding="12,5" Margin="0,0,16,0" FontWeight="Bold"/>
                <Button Content="🐍 导出 Python" Click="OnExport" Background="#FF334155" Foreground="White" BorderBrush="Transparent" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="⚙ 设置" Click="OnSettings" Background="#FF334155" Foreground="White" BorderBrush="Transparent" Padding="10,5"/>
            </StackPanel>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1" Margin="6,6,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 工具箱 -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="命令工具箱(双击添加)" FontWeight="Bold" Padding="10,8,0,6" Foreground="#FF1E293B"/>
                    <ListBox x:Name="ToolboxList" ItemsSource="{Binding Toolbox}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="Toolbox_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" Padding="2,3" FontSize="13" ToolTip="{Binding Info.Desc}"/>
                                    <Button Grid.Column="1" Content="＋" Padding="4,0" Margin="0,0,2,0" FontSize="12"
                                            Background="White" BorderBrush="#FFCBD5E1" ToolTip="添加此步骤"
                                            Click="ToolboxAdd_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF1B6DC8"
                                                   Margin="4,8,0,2" FontSize="12"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 步骤树 -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="脚本步骤(拖动排序,右键更多操作)" FontWeight="Bold" Padding="10,8,0,6" Foreground="#FF1E293B"/>
                    <TreeView x:Name="StepTree" ItemsSource="{Binding Steps}" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="Tree_RightDown"
                              MouseMove="Tree_MouseMove"
                              PreviewMouseLeftButtonUp="Tree_MouseUp"
                              AllowDrop="True" Drop="Tree_Drop" DragOver="Tree_DragOver">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:StepNodeVM}" ItemsSource="{Binding NodeItems}">
                                <Border x:Name="NodeBorder" Padding="4,3" CornerRadius="3" Background="Transparent" Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="勾选启用 / 取消禁用该步骤"/>
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource TreeItemText}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TreeItemText}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="NodeBorder" Property="Background" Value="#FFFFEDD5"/>
                                        <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#FFFB923C"/>
                                        <Setter TargetName="NodeBorder" Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:BranchVM}" ItemsSource="{Binding Items}">
                                <TextBlock Text="{Binding Label}" Foreground="#FF64748B" FontStyle="Italic" Margin="2,1"/>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制步骤" Click="OnCopyStep"/>
                                <MenuItem Header="删除步骤" Click="OnDeleteStep"/>
                                <Separator/>
                                <MenuItem Header="上移" Click="OnMoveUp"/>
                                <MenuItem Header="下移" Click="OnMoveDown"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 属性面板 -->
            <Border Grid.Column="4" Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="PropTitle" Text="步骤属性" FontWeight="Bold" Padding="10,8,0,6" Foreground="#FF1E293B"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PropertyRows}" Margin="10,0,10,10"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 日志 ============ -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Margin="6,6,6,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" FontWeight="Bold" Padding="10,6,0,4" Foreground="#FF1E293B"/>
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
            </DockPanel>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3" Background="#FF1E293B">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="#FF94A3B8" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" x:Name="ProjectPathText" Text="" Foreground="#FF64748B" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
